# dry = simulate only (default). live = sign and submit.
MODE=dry
SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443
TICK_SECONDS=60

# Models
# Models via OpenRouter (one key, top up credits in USDC)
OPENROUTER_API_KEY=
CLAUDE_MODEL=anthropic/claude-sonnet-5.5
OPENAI_MODEL=openai/gpt-6.1-sol

# Wallets: one per agent. Dry runs only need an address; live needs the secret key (suiprivkey...).
CLAUDE_ADDRESS=
CHATGPT_ADDRESS=
CLAUDE_SUI_SECRET_KEY=
CHATGPT_SUI_SECRET_KEY=

# Limits (SUI unless noted)
MAX_TRADE_SUI=5
MAX_POSITION_SUI=15
MAX_DAILY_SPEND_SUI=50
GAS_RESERVE_SUI=2
MAX_OPEN_POSITIONS=5
MAX_ACTIONS_PER_TICK=2
SLIPPAGE_BPS=300
MAX_SELL_BURN_BPS=1000
MAX_DRAWDOWN_BPS=3000
